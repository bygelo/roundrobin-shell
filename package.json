{
  "name": "roundrobin-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A discovery-driven operator UI for roundrobin OS. Renders what the server says is on.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preflight:db": "node script/preflight-db.mjs",
    "test": "npm run preflight:db && node script/run-test.mjs",
    "test:unit": "node script/run-test.mjs --unit",
    "test:live": "npm run preflight:db && node script/run-test.mjs --live",
    "dev": "npm run build:web && node --experimental-strip-types dev/server.ts",
    "dev:seed": "node --experimental-strip-types dev/seed.ts",
    "gate": "npm run typecheck && npm run build:web && npm run check:web && npm test",
    "build:web": "tsc -p tsconfig.web.json",
    "check:web": "node script/check-web-import.mjs"
  },
  "dependencies": {
    "@bygelo/roundrobin-access": "file:../roundrobin/package/access",
    "@bygelo/roundrobin-billing": "file:../roundrobin/package/billing",
    "@bygelo/roundrobin-booking": "file:../roundrobin/package/booking",
    "@bygelo/roundrobin-commerce": "file:../roundrobin/package/commerce",
    "@bygelo/roundrobin-document": "file:../roundrobin/package/document",
    "@bygelo/roundrobin-form": "file:../roundrobin/package/form",
    "@bygelo/roundrobin-kernel": "file:../roundrobin/package/kernel",
    "@bygelo/roundrobin-membership": "file:../roundrobin/package/membership",
    "@bygelo/roundrobin-notification": "file:../roundrobin/package/notification",
    "@bygelo/roundrobin-scan": "file:../roundrobin/package/scan",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
